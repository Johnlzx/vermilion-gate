{
  "name": "vermilion-gate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm sitemap:check && next build",
    "deploy": "pnpm build && wrangler pages deploy out --project-name=vermilion-gate",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test next.config.test.ts src/lib/*.test.ts src/components/*.test.ts functions/api/contact.test.ts functions/_utils/*.test.ts",
    "og:site": "tsx scripts/generate-og.ts",
    "sitemap:check": "tsx scripts/sitemap-check.ts",
    "sitemap:lock": "tsx scripts/sitemap-lock.ts"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "wrangler": "^4.83.0"
  }
}
